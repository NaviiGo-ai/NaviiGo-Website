# ════════════════════════════════════════════════════════════════
# NaviiGo — Environment Variables
# Copy this file to .env.local and fill in your keys.
# The app works in demo/mock mode without any keys.
# ════════════════════════════════════════════════════════════════

# ── AI Chat & Generation (Gemini) ─────────────────────────────
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Firebase (Authentication & Firestore) ─────────────────────
# Get from: Firebase Console → Project Settings → General
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# ── Python Backend URL ────────────────────────────────────────
# Change to your deployed backend URL in production
NEXT_PUBLIC_PYTHON_API_URL=http://localhost:8000

# ── Local Discovery Engine (Google Places) ───────────────────
# Enable at: https://console.cloud.google.com → Places API (New)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ── Smart Transport (Google Distance Matrix) ──────────────────
# Same key as Places works if you enable Distance Matrix API
GOOGLE_DISTANCE_MATRIX_KEY=your_google_distance_matrix_key_here

# ── Pinecone (Vector Search for Recommendations) ─────────────
# Sign up at: https://www.pinecone.io/
# Optional — recommendations work without it (CSV fallback)
PINECONE_API_KEY=your_pinecone_api_key_here

# ── Redis (Response Caching) ─────────────────────────────────
# Optional — falls back to file-based caching if unavailable
REDIS_URL=redis://localhost:6379

# ── Sentry (Error Tracking) ──────────────────────────────────
# Optional — sign up at: https://sentry.io/
SENTRY_DSN=your_sentry_dsn_here

# ── Backend CORS (Production only) ───────────────────────────
# Comma-separated list of allowed origins for the Python backend
CORS_ORIGINS=http://localhost:3000

# ── Weather (Open-Meteo) ─────────────────────────────────────
# 100% FREE, no API key required. Works out of the box.

# ── UPI QR Code (upiqr.in) ───────────────────────────────────
# FREE, no API key required. Works out of the box.

# ── YouTube Videos ───────────────────────────────────────────
# No API key needed. Uses public embed iframes.
