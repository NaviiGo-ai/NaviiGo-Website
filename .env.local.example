# ════════════════════════════════════════════════════════════════
# NaviiGo — Environment Variables
# Copy this file to .env.local and fill in your keys.
# IMPORTANT: Never commit .env.local to git!
# The app works in demo/mock mode without any keys.
# ════════════════════════════════════════════════════════════════

# ── AI Chat Assistant (Gemini) ────────────────────────────────
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Google Cloud Platform APIs ────────────────────────────────
# Maps Platform key (Places, Distance Matrix, Maps JS, Geocoding)
# Enable all required APIs at: https://console.cloud.google.com → APIs & Services
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_DISTANCE_MATRIX_KEY=your_google_distance_matrix_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── SerpApi (Flight, Hotel, Train search — real prices) ──────
# Get key at: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_api_key_here

# ── Booking.com APAC (optional fallback) ─────────────────────
# Get key at: https://developers.booking.com
BOOKING_APAC_API_KEY=your_booking_apac_api_key_here

# ── Amadeus (disabled — registration pending) ────────────────
# Get credentials at: https://developers.amadeus.com
# AMADEUS_CLIENT_ID=your_amadeus_client_id_here
# AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here

# ── Pinecone Vector Database ─────────────────────────────────
# Get key at: https://app.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_PROJECT_ID=your_pinecone_project_id_here
PINECONE_INDEX_NAME=naviigo-vectors

# ── Firebase Configuration ────────────────────────────────────
# Get these values from: Firebase Console → Project Settings → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id_here
FIRESTORE_DATABASE_ID=your_firestore_database_id_here

# ── Redis Cache ───────────────────────────────────────────────
# Local dev default: redis://localhost:6379/0
# Production: use Redis Cloud, AWS ElastiCache, or Upstash
# Format: redis://:password@host:port/db  (or rediss:// for TLS)
REDIS_URL=redis://localhost:6379/0

# ── Python Backend API ───────────────────────────────────────
# Local dev default: http://localhost:8000
NEXT_PUBLIC_PYTHON_API_URL=http://localhost:8000

# ── Weather (Open-Meteo) ─────────────────────────────────────
# 100% FREE, no API key required. Works out of the box.

# ── UPI QR Code (upiqr.in) ───────────────────────────────────
# FREE, no API key required. Works out of the box.

# ── YouTube Videos ───────────────────────────────────────────
# No API key needed. Uses public embed iframes.
