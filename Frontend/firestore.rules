rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// NaviiGo — Firestore rules for the named database `naviigo-db`
// (see firebase.json → firestore.database)
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Keys this write adds / changes / removes (equal values are not "changed").
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ─── User data — owner only ──────────────────────────────────────────────
    // users/{uid}
    //   users/{uid}/preferences/main
    //   users/{uid}/itineraries/{id}
    //   users/{uid}/tracking/{tripId}  +  .../locations/{id}
    //   users/{uid}/trips/{tripId}                      (expenseState, checkpoints)
    //   users/{uid}/passport/stats  +  .../stamps/entries/{id}
    //   users/{uid}/bucketList/{id}
    //   users/{uid}/personalization/{signals|taste}
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /itineraries/{itineraryId} {
        allow read, write: if isOwner(userId);
        match /proposals/{proposalId} {
          allow read: if isOwner(userId);
          allow write: if false; // Admin SDK/backend creates the mutation authority.
        }
      }
      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(userId) && subcollection != 'itineraries';
      }
    }

    // ─── Public itinerary projections — itineraries/{shareId} ────────────────
    // This collection is never an owner store.  It contains only an explicit,
    // sanitized projection created by the authenticated owner.  Full form data,
    // generated payloads, browsing signals, and lifecycle state live below the
    // owner's users/{uid}/itineraries document instead.
    match /itineraries/{shareId} {
      function isProjection(data) {
        return data.shareProjection == true
          && data.isPublic == true
          && data.ownerUid is string
          && data.ownerUid != ''
          && data.shareId == shareId;
      }

      function hasProjectionShape(data) {
        return data.keys().hasAll([
            'shareId', 'shareProjection', 'isPublic', 'ownerUid',
            'form', 'generatedData', 'destName', 'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'shareId', 'shareProjection', 'isPublic', 'ownerUid',
            'form', 'generatedData', 'destName', 'createdAt', 'updatedAt'
          ])
          && data.form is map
          && data.form.keys().hasOnly(['destination', 'destName', 'startDate', 'endDate', 'days'])
          && data.generatedData is map
          && data.generatedData.keys().hasOnly([
            'description', 'avgCost', 'weather', 'crowdLevel', 'crowdNote',
            'mapCenter', 'highlights', 'restaurants', 'hotels', 'dayPlans'
          ])
          && data.destName is string;
      }

      // A signed-in creator must be able to test a fresh share ID before a transaction.
      allow get: if (resource == null && signedIn()) || (isProjection(resource.data) && hasProjectionShape(resource.data));
      allow list: if isProjection(resource.data) && hasProjectionShape(resource.data);

      allow create: if signedIn()
        && isProjection(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && hasProjectionShape(request.resource.data);

      allow update: if signedIn()
        && isProjection(resource.data)
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && isProjection(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.shareId == resource.data.shareId
        && hasProjectionShape(request.resource.data);

      allow delete: if signedIn()
        && isProjection(resource.data)
        && resource.data.ownerUid == request.auth.uid;
    }

    // ─── Leaderboard — leaderboard/{uid} ─────────────────────────────────────
    // Public read (it is a public ranking). Each user may only write their own
    // row. NOTE: XP is computed client-side, so a user can inflate their own
    // score — move this write to the backend/Admin SDK if that matters.
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // ─── Destination reviews — reviews/{destId}/entries/{reviewId} ──────────
    match /reviews/{destId} {
      match /entries/{reviewId} {
        allow read: if true;

        // Must be signed in and reviewing as yourself.
        allow create: if signedIn()
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.helpfulCount == 0;

        // Anyone signed in may vote "helpful" — but only the counter, and it
        // can only go up. (A literal +1 equality check would break here:
        // FieldValue.increment() is applied *after* rules run, so
        // request.resource.data still holds the pre-increment value.)
        allow update: if signedIn()
                      && changedKeys().hasOnly(['helpfulCount'])
                      && request.resource.data.helpfulCount
                         >= resource.data.helpfulCount;

        allow delete: if signedIn()
                      && resource.data.userId == request.auth.uid;
      }
    }

    // ─── Destination metadata — server / Admin SDK only ─────────────────────
    match /destinations/{destId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
